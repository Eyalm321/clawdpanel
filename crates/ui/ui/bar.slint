// ClawdPanel HUD bar — S4 (#51): full 1:1 visual-fidelity pass.
//
// The data-driven segments, themes, warn classes, separator-normalization and
// interactions that mirror `frontend/index.html` + `frontend/src/main.js` +
// `frontend/src/style.css`. Data arrives on the `ClaudeBar` global (filled from
// claude-core), the palette on the `Theme` global, and UI→backend intents on the
// `Backend` global. Docking / framelessness stay in the platform slice.

// Embed Cascadia Mono. A bare file-import of a .ttf makes the Slint compiler
// bake the font bytes into the binary (Rust output defaults to
// EmbedAllResources) and register it at component init, so `font-family:
// "Cascadia Mono"` resolves with no runtime/filesystem dependency.
import "../fonts/CascadiaMono.ttf";

import { Theme, ThemeId } from "theme.slint";
import { SegBox, Sep, Glyph, Arrow, Invader, PinIcon, GhostChip, Scanlines, OutlinedProgress } from "atoms.slint";

// Re-export the Theme global so Rust can reach it (`ui.global::<Theme>()`) to
// hold + push the selected `index`.
export { Theme }

// The bar payload pushed from claude-core (the display-ready shape). Percents are
// carried both as a 0.0..=1.0 float (for the outlined bar width) and as the
// pre-formatted value/meter strings the warn-color thresholds drive.
export struct ClaudeBarData {
    account-name: string,        // already upper-cased
    subscription-type: string,   // already upper-cased, "" when none
    period-label: string,        // "WEEKLY" | "MSGS"
    period-value: string,        // "90%" | "90.5K"
    period-has-limit: bool,
    period-percent: float,
    period-warn-medium: bool,
    period-warn-high: bool,
    weekly-fill: string,         // filled ░▒▓█ run
    weekly-empty: string,        // trailing · run
    show-hourly: bool,
    hourly-value: string,        // "42%"
    hourly-percent: float,
    hourly-warn-medium: bool,
    hourly-warn-high: bool,
    hourly-fill: string,
    hourly-empty: string,
    hourly-reset-in: string,
    reset-in: string,
    primary-model: string,
}

export global ClaudeBar {
    in property <ClaudeBarData> data;
    // BUSY / IDLE / OFFLINE, pushed on the 500ms status path.
    in property <string> status: "IDLE";

    // Counts that gate the cycler arrows (<2 hides them), set at startup.
    in property <int> accounts-count: 1;
    in property <int> monitors-count: 1;
    in property <string> monitor-label: "1";

    // Feature toggles (wired from config in S6 — default everything on).
    in property <bool> show-weekly: true;
    in property <bool> show-radio: true;
    in property <bool> show-monitor: true;
    in property <bool> show-theme: true;
    // 5H usage is both feature-gated AND data-gated; the segment shows only when
    // the feature is on and live data carries an hourly percent.
    in property <bool> feature-hourly: true;

    // Pin state (visual; auto-hide wiring is the platform slice).
    in-out property <bool> pinned: true;

    // step-end blink flag (Matrix caret), toggled by the BarWindow timer.
    in-out property <bool> blink: false;

    // Per-separator visibility, computed in Rust by `normalize_separators` so a
    // hidden segment never leaves a doubled/dangling "·". 9 entries, left→right:
    // [acct|weekly, weekly|reset, reset|5h, 5h|5hreset, 5hreset|model,
    //  model|status, radio|mon, mon|theme, theme|pin].
    in property <[bool]> sep-visible;
}

// UI → backend intents (style.css / main.js click handlers) + the system-tray
// menu actions (S5). The tray (a native muda menu, not Slint) invokes these from
// the Slint event-loop thread so the wiring lives in one place — Rust ports the
// `tray.Controller` callbacks onto them.
export global Backend {
    callback cycle-account(int);
    callback cycle-monitor(int);
    callback cycle-theme(int);
    callback toggle-pin();
    callback toggle-brand-menu();

    // Tray menu actions.
    callback set-active-account(int);
    callback set-monitor(int);
    callback toggle-startup();
    callback open-settings();
    callback check-for-updates();
    callback quit();
}

// Radio playback bridge (S7, #54). Properties pushed from the media engine's
// `radio:state` consumer (filtered to the active station); callbacks drive the
// StationPlayer / Controller. Replaces the JS `main.js:380-739` radio segment.
export global RadioBridge {
    // off | load | on | err (drives the play/pause icon + color).
    in property <string> status: "off";
    in property <string> station-name: "---";
    in property <bool> shuffle-on: false;
    // Whether the active station can step track-by-track (gates the ‹ › chips).
    in property <bool> track-nav-active: false;
    // Cycler arrows show only with >= 2 stations.
    in property <int> stations-count: 0;
    // Seek timeline: playhead + length in seconds. dur <= 0 ⇒ livestream (LIVE).
    in property <float> pos: 0;
    in property <float> dur: 0;
    in property <int> volume-pct: 100;
    // Inline scrubber visibility (toggled by clicking the title).
    in-out property <bool> timeline-open: false;

    callback play-pause();
    callback next-station(int); // dir -1 / +1
    callback track-next();
    callback track-prev();
    callback toggle-shuffle();
    callback seek(float); // fraction 0..1 (the app multiplies by dur)
    callback cycle-volume();
}

// Radio status glyph: the play triangle (off/load/err) or pause bars (on),
// 11×11 to match `.radio-ico`, drawn from the exact index.html SVG paths.
//
// Heartbeat (style.css `@keyframes radio-pulse` / `soundwave`): loading pulses
// the clay play icon (radio-pulse 0.8s, opacity .35↔1); playing pulses the green
// pause icon (soundwave 1.5s, opacity .7↔1); error is a static red glyph and off
// is a static muted glyph (no pulse — it STOPS on error). Slint has no looping
// CSS keyframes, so a half-period Timer flips `hi` and `animate opacity` eases
// each half — a faithful triangle of the keyframe (ui-slint.md timer pattern).
component RadioStatusIcon inherits Rectangle {
    in property <string> status;
    in property <color> tint;
    width: 11px;
    height: 11px;

    // Pulse only while loading/playing; err/off hold a static glyph.
    property <bool> pulsing: root.status == "load" || root.status == "on";
    property <bool> hi: false;
    // soundwave bottoms out at .7, radio-pulse at .35.
    property <float> lo: root.status == "on" ? 0.7 : 0.35;
    // Half the keyframe period (soundwave 1.5s / radio-pulse 0.8s).
    property <duration> half: root.status == "on" ? 750ms : 400ms;

    opacity: root.pulsing ? (root.hi ? 1.0 : root.lo) : 1.0;
    animate opacity { duration: root.half; easing: ease-in-out; }

    pulse-timer := Timer {
        interval: root.half;
        running: root.pulsing;
        triggered => { root.hi = !root.hi; }
    }

    if root.status != "on" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M8 5v14l11-7z";
        fill: root.tint;
    }
    if root.status == "on" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M8 5v14 M16 5v14";
        fill: transparent;
        stroke: root.tint;
        stroke-width: 0.92px;
    }
}

// The radio cluster: « ‹ TITLE/scrubber › » ▶/⏸ shuffle | VOL nn%. Behavior is
// driven entirely by the RadioBridge global.
component RadioCluster inherits Rectangle {
    height: 100%;
    width: layout.preferred-width;

    // Status-glyph color (style.css): playing → green, loading → clay, error →
    // red, off/idle → muted. (The old port mis-mapped on→clay, load→lbl.)
    property <color> status-tint:
        RadioBridge.status == "err" ? Theme.red :
        RadioBridge.status == "on" ? Theme.green :
        RadioBridge.status == "load" ? Theme.clay :
        (radio-ta.has-hover ? Theme.text : Theme.muted);
    // Scrubber fill: clay (`.radio-tl-fill`), green @ .5 alpha for a livestream
    // (`.radio-timeline.live .radio-tl-fill`) — independent of the status color.
    property <color> seek-tint: root.is-live ? Theme.green.with-alpha(0.5) : Theme.clay;
    property <bool> is-live: RadioBridge.dur <= 0;
    property <float> frac: RadioBridge.dur > 0
        ? clamp(RadioBridge.pos / RadioBridge.dur, 0.0, 1.0)
        : 1.0;
    property <length> scroll-x: 0;
    property <string> marquee-text: "NOW PLAYING " + RadioBridge.station-name + " · ";

    property <color> title-color: radio-ta.has-hover ? Theme.clay : Theme.lbl;
    property <color> vol-lbl-color: radio-ta.has-hover ? Theme.clay : Theme.lbl;
    property <color> vol-val-color: radio-ta.has-hover ? Theme.text : Theme.clay;

    radio-ta := TouchArea {
        width: 100%;
        height: 100%;
    }

    // Marquee scroll: nudge the title left while playing, re-entering from the
    // right edge after a fixed run (Slint has no looping animation, and ids
    // inside `if` aren't visible here, so we use a fixed reset distance).
    marquee-timer := Timer {
        interval: 30ms;
        running: RadioBridge.status == "on" && !RadioBridge.timeline-open;
        triggered => {
            root.scroll-x -= 1px;
            if (root.scroll-x <= -340px) { root.scroll-x = 168px; }
        }
    }

    layout := HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        spacing: 5px;
        alignment: start;

        // Left transport cluster [« ‹] (2px internal pitch).
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                width: self.preferred-width;
                spacing: 2px;
                alignment: start;
                // « prev station
                if RadioBridge.stations-count >= 2 : GhostChip {
                    clicked => { RadioBridge.next-station(-1); }
                    Glyph { text: "«"; font-size: 9px; color: Theme.muted; font-weight: 400; }
                }
                // ‹ prev track (grayed when the station can't step)
                GhostChip {
                    disabled: !RadioBridge.track-nav-active;
                    clicked => { RadioBridge.track-prev(); }
                    Glyph { text: "‹"; font-size: 9px; color: Theme.muted; font-weight: 400; }
                }
            }
        }

        // Title / scrubber viewport (fixed 168px, sized to the scrubber).
        Rectangle {
            width: 168px;
            clip: true;

            // ── marquee / idle title ──
            if !RadioBridge.timeline-open && RadioBridge.status == "on" : Glyph {
                x: root.scroll-x;
                text: root.marquee-text;
                color: root.title-color;
            }
            if !RadioBridge.timeline-open && RadioBridge.status != "on" : Glyph {
                x: 0;
                text: RadioBridge.station-name == "" ? "CLAUDE FM" : RadioBridge.station-name;
                color: root.title-color;
            }
            // Click the title to reveal the scrubber.
            if !RadioBridge.timeline-open : TouchArea {
                mouse-cursor: pointer;
                clicked => { RadioBridge.timeline-open = true; }
            }

            // ── inline scrubber ──
            if RadioBridge.timeline-open : Rectangle {
                // groove
                Rectangle {
                    y: (parent.height - 4px) / 2;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.prog-empty;
                    Rectangle {
                        x: 0;
                        y: 0;
                        height: 100%;
                        width: parent.width * root.frac;
                        border-radius: 2px;
                        background: root.seek-tint;
                    }
                }
                if root.is-live : Glyph {
                    x: 0;
                    text: "LIVE";
                    font-size: 9px;
                    // `.radio-timeline.live #radio-time-cur { color: var(--green) }`.
                    color: Theme.green;
                }
                seek-ta := TouchArea {
                    mouse-cursor: root.is-live ? MouseCursor.default : MouseCursor.pointer;
                    clicked => {
                        if (!root.is-live && self.width > 0) {
                            RadioBridge.seek(self.mouse-x / self.width);
                        }
                    }
                }
                // Auto-collapse a few seconds after the cursor leaves the scrubber.
                collapse-timer := Timer {
                    interval: 3s;
                    running: RadioBridge.timeline-open && !seek-ta.has-hover;
                    triggered => { RadioBridge.timeline-open = false; }
                }
            }
        }

        // Right transport cluster [› » ▶ shuffle] (2px internal pitch).
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                width: self.preferred-width;
                spacing: 2px;
                alignment: start;
                // › next track
                GhostChip {
                    disabled: !RadioBridge.track-nav-active;
                    clicked => { RadioBridge.track-next(); }
                    Glyph { text: "›"; font-size: 9px; color: Theme.muted; font-weight: 400; }
                }
                // » next station
                if RadioBridge.stations-count >= 2 : GhostChip {
                    clicked => { RadioBridge.next-station(1); }
                    Glyph { text: "»"; font-size: 9px; color: Theme.muted; font-weight: 400; }
                }

                // play / pause
                GhostChip {
                    clicked => { RadioBridge.play-pause(); }
                    RadioStatusIcon {
                        status: RadioBridge.status;
                        tint: root.status-tint;
                    }
                }
                // shuffle (clay when on, muted when off)
                GhostChip {
                    clicked => { RadioBridge.toggle-shuffle(); }
                    Path {
                        width: 10px;
                        height: 10px;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: "M2 18h1.4c1.3 0 2.5-.6 3.3-1.7l6.1-8.6c.7-1.1 2-1.7 3.3-1.7H22 M18 2l4 4-4 4 M2 6h1.9c1.5 0 2.9.9 3.6 2.2 M22 18h-5.9c-1.3 0-2.6-.7-3.3-1.8l-.5-.8 M18 14l4 4-4 4";
                        fill: transparent;
                        stroke: RadioBridge.shuffle-on ? Theme.clay : Theme.muted;
                        stroke-width: 0.92px;
                    }
                }
            }
        }

        Sep {}
        Glyph { text: "VOL"; color: root.vol-lbl-color; }
        Rectangle {
            width: vol.preferred-width;
            vol := Glyph { text: RadioBridge.volume-pct + "%"; color: root.vol-val-color; }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { RadioBridge.cycle-volume(); }
            }
        }
    }
}

// A weekly / 5H usage segment: LABEL: value [progress] (+ Matrix caret). The
// value + progress fill take the warn color (clay → #eab308 ≥85% → red ≥95%);
// the empty meter dots stay muted. Fallout swaps the text meter for the solid
// outlined bar.
component UsageSeg inherits SegBox {
    in property <string> label;
    in property <string> value;
    in property <string> fill;
    in property <string> empty;
    in property <float> pct;
    in property <bool> has-limit;
    in property <bool> warn-medium;
    in property <bool> warn-high;
    in property <bool> show-caret: false;

    property <color> tint:
        root.warn-high ? Theme.red :
        root.warn-medium ? #eab308 :
        Theme.clay;

    Glyph {
        text: root.label + ":";
        color: Theme.lbl;
    }
    // val-wrap: value + progress, no internal gap (the .prog margin is faked).
    HorizontalLayout {
        spacing: 0;
        alignment: start;
        Glyph {
            text: root.value;
            color: root.tint;
        }
        if root.has-limit : Rectangle { width: 4px; }   // .prog margin-left
        // ── character meter (Claude / Amber / Matrix / Dracula) ──
        if root.has-limit && !Theme.outlined-progress : HorizontalLayout {
            spacing: 0;
            Glyph {
                text: root.fill;
                color: root.tint;
                letter-spacing: -0.11px;
            }
            Glyph {
                text: root.empty;
                color: Theme.prog-empty;
                letter-spacing: -0.11px;
            }
        }
        // ── solid outlined bar (Fallout) ──
        if root.has-limit && Theme.outlined-progress : VerticalLayout {
            alignment: center;
            OutlinedProgress {
                pct: root.pct;
                tint: root.tint;
            }
        }
        // Matrix blinking █ caret (step-end on/off via the blink flag).
        if root.show-caret && Theme.blink-caret : Glyph {
            text: "█";
            color: root.tint;
            opacity: ClaudeBar.blink ? 1.0 : 0.0;
        }
    }
}

// A plain LABEL: value segment (RESET, 5H RESET).
component LabelVal inherits SegBox {
    in property <string> label;
    in property <string> value;
    Glyph {
        text: root.label + ":";
        color: Theme.lbl;
    }
    Glyph {
        text: root.value;
        color: Theme.clay;
    }
}

export component BarWindow inherits Window {
    title: "ClawdPanel";
    background: Theme.bg;
    preferred-width: 1920px;
    preferred-height: 28px;
    min-height: 28px;
    in-out property <length> window-width: 1920px;
    width: root.window-width;

    in-out property <bool> has-hover: window-ta.has-hover;
    window-ta := TouchArea {
        width: 100%;
        height: 100%;
    }

    // OFFLINE renders as IDLE on the bar (and stays lavender) — main.js maps it
    // before setting the class, so the gray `.offline` rule never actually fires.
    function status-text() -> string {
        ClaudeBar.status == "OFFLINE" ? "IDLE" : ClaudeBar.status;
    }
    function theme-name() -> string {
        Theme.index == 1 ? "FALLOUT" :
        Theme.index == 2 ? "AMBER" :
        Theme.index == 3 ? "MATRIX" :
        Theme.index == 4 ? "DRACULA" :
                           "CLAUDE";
    }
    // Rust owns the theme index (holds + persists it, mirroring the old
    // localStorage cross-window behavior): the arrows just fire the intent and
    // Rust pushes the new `Theme.index` straight back for an instant repaint.
    function cycle-theme(dir: int) {
        Backend.cycle-theme(dir);
    }

    // step-end blink for the Matrix caret: a hard on/off toggle rather than an
    // eased opacity animation (ui-slint.md mitigation #5).
    blink-timer := Timer {
        interval: 500ms;
        running: Theme.blink-caret;
        triggered => { ClaudeBar.blink = !ClaudeBar.blink; }
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 0;
        alignment: stretch;

        // ── Brand (always visible) ── padding 0 6px 0 2px, clickable.
        Rectangle {
            height: 100%;
            width: 23px; // 15px + 2px left + 6px right
            brand := Invader {
                x: 2px;
                y: (parent.height - self.height) / 2;
                width: 15px;
                height: 11px;
                hover: brand-ta.has-hover;
            }
            brand-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { Backend.toggle-brand-menu(); }
            }
        }
        Sep {}

        // ── Account: ◀ NAME [PLAN] ▶ ── (arrows hidden < 2 accounts)
        SegBox {
            if ClaudeBar.accounts-count >= 2 : Arrow {
                glyph: "◀";
                clicked => { Backend.cycle-account(-1); }
            }
            Rectangle {
                width: acct.preferred-width;
                acct := Glyph {
                    text: ClaudeBar.data.account-name == "" ? "---" : ClaudeBar.data.account-name;
                    color: Theme.clay;
                }
                if ClaudeBar.accounts-count >= 2 : TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Backend.cycle-account(1); }
                }
            }
            if ClaudeBar.data.subscription-type != "" : Glyph {
                text: "[" + ClaudeBar.data.subscription-type + "]";
                color: Theme.sub;
                font-size: 10px;
            }
            if ClaudeBar.accounts-count >= 2 : Arrow {
                glyph: "▶";
                clicked => { Backend.cycle-account(1); }
            }
        }
        if ClaudeBar.sep-visible[0] : Sep {}

        // ── Weekly / Msgs ──
        if ClaudeBar.show-weekly : UsageSeg {
            label: ClaudeBar.data.period-label;
            value: ClaudeBar.data.period-value;
            fill: ClaudeBar.data.weekly-fill;
            empty: ClaudeBar.data.weekly-empty;
            pct: ClaudeBar.data.period-percent;
            has-limit: ClaudeBar.data.period-has-limit;
            warn-medium: ClaudeBar.data.period-warn-medium;
            warn-high: ClaudeBar.data.period-warn-high;
            show-caret: true;
        }
        if ClaudeBar.sep-visible[1] : Sep {}

        // ── Weekly reset countdown ──
        if ClaudeBar.show-weekly : LabelVal {
            label: "RESET";
            value: ClaudeBar.data.reset-in == "" ? "---" : ClaudeBar.data.reset-in;
        }
        if ClaudeBar.sep-visible[2] : Sep {}

        // ── 5-hour rolling usage ──
        if ClaudeBar.data.show-hourly && ClaudeBar.feature-hourly : UsageSeg {
            label: "5H";
            value: ClaudeBar.data.hourly-value;
            fill: ClaudeBar.data.hourly-fill;
            empty: ClaudeBar.data.hourly-empty;
            pct: ClaudeBar.data.hourly-percent;
            has-limit: true;
            warn-medium: ClaudeBar.data.hourly-warn-medium;
            warn-high: ClaudeBar.data.hourly-warn-high;
        }
        if ClaudeBar.sep-visible[3] : Sep {}

        // ── 5-hour reset countdown ──
        if ClaudeBar.data.show-hourly && ClaudeBar.feature-hourly : LabelVal {
            label: "RESET";
            value: ClaudeBar.data.hourly-reset-in == "" ? "---" : ClaudeBar.data.hourly-reset-in;
        }
        if ClaudeBar.sep-visible[4] : Sep {}

        // ── Primary model ──
        SegBox {
            Glyph {
                text: ClaudeBar.data.primary-model == "" ? "---" : ClaudeBar.data.primary-model;
                color: Theme.clay;
            }
        }
        if ClaudeBar.sep-visible[5] : Sep {}

        // ── Session status (idle/busy lavender; offline shown as IDLE) ──
        SegBox {
            Glyph {
                text: root.status-text();
                color: Theme.status-active;
            }
        }

        // flex:1 spacer — pushes the right cluster to the edge.
        Rectangle { horizontal-stretch: 1; }

        // ── Radio cluster (S7, #54): behavior driven by the RadioBridge global ──
        if ClaudeBar.show-radio : RadioCluster {}
        if ClaudeBar.sep-visible[6] : Sep {}

        // ── Monitor cycler: ◀ MON n ▶ ──
        if ClaudeBar.show-monitor : SegBox {
            if ClaudeBar.monitors-count >= 2 : Arrow {
                glyph: "◀";
                clicked => { Backend.cycle-monitor(-1); }
            }
            Glyph { text: "MON"; color: Theme.lbl; }
            Glyph { text: ClaudeBar.monitor-label; color: Theme.clay; }
            if ClaudeBar.monitors-count >= 2 : Arrow {
                glyph: "▶";
                clicked => { Backend.cycle-monitor(1); }
            }
        }
        if ClaudeBar.sep-visible[7] : Sep {}

        // ── Theme cycler: ◀ THEME NAME ▶ ──
        if ClaudeBar.show-theme : SegBox {
            Arrow {
                glyph: "◀";
                clicked => { root.cycle-theme(-1); }
            }
            Glyph { text: "THEME"; color: Theme.lbl; }
            Rectangle {
                width: theme-glyph.preferred-width;
                theme-glyph := Glyph {
                    text: root.theme-name();
                    color: Theme.clay;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.cycle-theme(1); }
                }
            }
            Arrow {
                glyph: "▶";
                clicked => { root.cycle-theme(1); }
            }
        }
        if ClaudeBar.sep-visible[8] : Sep {}

        // ── Pin toggle ──
        SegBox {
            Rectangle {
                width: 20px;
                PinIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    pinned: ClaudeBar.pinned;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        ClaudeBar.pinned = !ClaudeBar.pinned;
                        Backend.toggle-pin();
                    }
                }
            }
        }
    }

    // Bottom hairline border (1px rgba(107,114,128,.15)).
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: rgba(107, 114, 128, 0.15);
    }

    // CRT scanline overlay, drawn on top, gated on the active theme.
    if Theme.crt : Scanlines {
        width: 100%;
        height: 100%;
    }
}
